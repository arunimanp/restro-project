{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/orders/:id/status",
      "destination": "/api/orders/status?id=:id"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/public/$1"
    }
  ]
}

